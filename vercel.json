{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
